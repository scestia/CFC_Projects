# **🔐** 7**.  Brute-force Check**

```python
# ------------------ BRUTE-FORCE ------------------

def check_weak_passwords(nmap_output, output_dir, username_list, password_list, stop_on_success=True):
    # Dictionary mapping services to their standard ports
    services = {
        "ssh": 22,
        "ftp": 21,
        "rdp": 3389,
        "telnet": 23
    }

    print("[*] Extracting live hosts from Nmap output...")
    live_hosts = []
    with open(nmap_output, 'r') as file:
        for line in file:
            if line.startswith("Nmap scan report for"):
                # Check if IP is inside parentheses, else fallback to last part of line
                match = re.search(r'\(([\d.]+)\)', line)
                if match:
                    ip = match.group(1)
                else:
                    ip = line.strip().split()[-1]
                live_hosts.append(ip)

    if not live_hosts:
        print("[-] No live hosts found for brute-force testing.")
        return

    print("[*] Running brute-force tests for weak passwords...")
    for host in live_hosts:
        for service, port in services.items():
            output_file = os.path.join(output_dir, f"{host}_{service}_hydra.txt")
            print(f"[*] Testing {service.upper()} on {host}:{port}...")

            # Use Medusa for SSH, and Hydra for other services
            if service == "ssh":
                subprocess.run([
                    "medusa", "-U", username_list, "-P", password_list,
                    "-h", host, "-M", "ssh", "-n", str(port), "-f", "-O", output_file
                ])
            else:
                subprocess.run([
                    "hydra", "-L", username_list, "-P", password_list,
                    f"{host}", service, "-s", str(port), "-o", output_file
                ])

            # If stop_on_success is enabled, break on first found credentials
            if stop_on_success:
                with open(output_file, 'r') as f:
                    for line in f:
                        if "login:" in line.lower() and "password:" in line.lower():
                            print(f"[+] Valid credentials found in {output_file}. Stopping further brute-force attempts.")
                            return
