# ------------------ MASSCAN ------------------

def run_masscan(network, output_dir):
    # Use Masscan to discover open ports quickly
    print("[*] Running Masscan to quickly discover open ports...")
    masscan_output = os.path.join(output_dir, "masscan_output.txt")
    subprocess.run([
        "masscan", network, "-p1-65535", "--rate", "10000", "-oL", masscan_output
