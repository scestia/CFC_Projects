# ------------------ NSE SCRIPT SCAN ------------------

def run_targeted_nse(network, services, output_dir):
    print("[*] Running hand-picked NSE scripts for vulnerability assessment...")

    # Predefined list of services with relevant NSE scripts
    nse_scripts = {
        "ftp": ["ftp-anon", "ftp-vsftpd-backdoor"],
        "ssh": ["ssh-auth-methods", "ssh-brute"],
        "http": ["http-enum", "http-vuln-cve2017-5638"],
        "smb": ["smb-vuln-ms17-010", "smb-enum-users"],
        "mysql": ["mysql-empty-password", "mysql-vuln-cve2012-2122"],
        "telnet": ["telnet-ntlm-info", "telnet-brute"]
    }

    # Determine which scripts to run based on detected services
    selected_scripts = []
    for svc in services:
        if svc in nse_scripts:
            selected_scripts.extend(nse_scripts[svc])

    if selected_scripts:
        scripts_str = ",".join(selected_scripts)
        output_path = os.path.join(output_dir, "nse_vuln_results.txt")
        # Run Nmap with the selected NSE scripts and a timeout
        subprocess.run([
            "nmap", "-T4", "-sV", f"--script={scripts_str}", "--script-timeout=10s", "-oN", output_path, network
        ])
    else:
        print("[-] No target services found for NSE vuln scan.")
